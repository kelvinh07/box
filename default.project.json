{
  "name": "HatchABrainrot",
  "globIgnorePaths": ["**/*.spec.luau"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/Shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/Server"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "ShopModel": { "$path": "src/ServerStorage/ShopModel.rbxm" },
      "EggIncubatorModel": { "$path": "src/ServerStorage/EggIncubatorModel.rbxm" },
      "BrainrotModels": { "$path": "src/ServerStorage/BrainrotModels.rbxm" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/Client"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 196.2,
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "ShadowMap",
        "Ambient": [0.3137, 0.3137, 0.3137],
        "OutdoorAmbient": [0.5882, 0.549, 0.5882],
        "Brightness": 4,
        "ExposureCompensation": 0.1,
        "ColorShift_Top": [1, 0.9804, 0.949],
        "ClockTime": 14,
        "GeographicLatitude": 41.9,
        "FogEnd": 100000
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "MaxPlayers": 6
      }
    }
  }
}
