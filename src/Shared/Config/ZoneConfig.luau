ZoneConfig.MaxZone = 12

-- CASH cost to BREAK the wall INTO each zone (zone progression is now decoupled from rebirth).
-- Zone 1 is the starting zone (free). Cash RESETS on rebirth, so these are per-run costs; the
-- curve uses INCREASING ratios so each successive zone takes a bit longer to reach than the last.
-- Beyond the table: previous * UnlockCashGrowth (floored). Tuned STARTER values — edit freely.
ZoneConfig.UnlockCash = {
	[1] = 0,
	[2] = 1500,
	[3] = 8000,
	[4] = 42000,
	[5] = 240000,
	[6] = 1400000,
	[7] = 8800000,
	[8] = 58000000,
	[9] = 406000000,
	[10] = 2842000000,
	[11] = 19894000000,
	[12] = 139258000000,
}
ZoneConfig.UnlockCashGrowth = 7

-- Cash needed to break into `zone`. Zone <= 1 is free (starting zone).
function ZoneConfig.unlockCash(zone: number): number
	if zone <= 1 then
		return 0
	end
	local c = ZoneConfig.UnlockCash[zone]
	if c then
		return c
	end
	local value = ZoneConfig.UnlockCash[ZoneConfig.MaxZone]
	for _ = ZoneConfig.MaxZone + 1, zone do
		value = math.floor(value * ZoneConfig.UnlockCashGrowth)
	end
	return value
end

function ZoneConfig.get(zone: number)
	return ZoneConfig.Zones[zone]
end

-- Highest zone a player with `rebirths` rebirths is allowed to enter.
function ZoneConfig.highestUnlocked(rebirths: number): number
	local best = 1
	for zoneId, data in pairs(ZoneConfig.Zones) do
		if rebirths >= data.UnlockRebirths and zoneId > best then
			best = zoneId
		end
	end
	return best
end

----------------------------------------------------------------------- DIG ODDS
-- GENERATED egg-rarity odds, so the curve keeps making sense automatically as zones are added.
-- The design is a deliberate "TEASER" curve — the rare tiers appear EARLY but at tiny DECIMAL
-- percentages, so players see a rare egg is *technically possible* and keep grinding for it:
--   * The commonest eggs dominate the early zones; the whole distribution SLIDES toward rarer
--     eggs as the zone climbs (OddsShiftPerZone), but OddsShiftCap stops the rarest tier from ever
--     dominating — Mythic plateaus at a single-digit % no matter how deep, so it stays a jackpot.
--   * Each rarity is introduced from its RarityIntroZone and FADES IN over OddsIntroFade zones, so
--     a freshly-introduced rarity enters as a SUB-1% sliver and grows: Legendary/Mythic enter well
--     under 1% (decimals kept — never rounded away) and only creep up. Their % "makes sense" with
--     how rare each tier is, and the tiniest odds are still REAL (genuinely hatchable).
-- Generated result: z1 80/20, z2 .../Rar 3.9, z3 .../Epi 1.5, z4 .../Leg 0.83, z5 .../Myt 0.6,
--   z6 Myt 1.7, z7 Myt 3.3 … plateauing around Myt ≈ 6-9% in the deepest zones (never 38%!).
ZoneConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }
-- The zone at which each rarity FIRST appears (one new tier per zone). Earlier = a teaser sooner;
-- the fade + the geometric falloff keep the entry tiny. Adding a new rarity later = append it here
-- + to EggConfig.Order.
ZoneConfig.RarityIntroZone = { Common = 1, Uncommon = 1, Rare = 2, Epic = 3, Legendary = 4, Mythic = 5 }
ZoneConfig.OddsShiftBase = 0.25    -- rarer:commoner weight ratio at zone 1 (0.25 ⇒ an 80/20 split)
ZoneConfig.OddsShiftPerZone = 0.08 -- how fast the mass slides toward rarer eggs each deeper zone (LOWER = slower)
ZoneConfig.OddsShiftCap = 0.80     -- the slide STOPS here so the rarest tier can never dominate (lower = rarer jackpot)
ZoneConfig.OddsIntroFade = 14      -- zones a newly-introduced rarity takes to ramp from its sliver to full weight

-- Weighted egg-rarity odds (DECIMAL percentages) for digging in `zone`. Works for ANY zone number,
-- so new zones need no odds table. Tiny teaser tiers are KEPT (never dropped) so a 0.6% Mythic is a
-- genuine pull. weightedPick only needs ratios, so the table is not forced to a round 100 sum.
-- An explicit Zones[zone].DigOdds overrides this entirely.
function ZoneConfig.digOdds(zone: number): { [string]: number }
	local data = ZoneConfig.Zones[zone]
	if data and data.DigOdds then
		return data.DigOdds -- explicit per-zone override wins
	end

	local shift = math.clamp(ZoneConfig.OddsShiftBase + ZoneConfig.OddsShiftPerZone * (zone - 1), 0.02, ZoneConfig.OddsShiftCap)
	local raw: { [string]: number } = {}
	local total = 0
	for i, rarity in ipairs(ZoneConfig.RarityOrder) do
		local intro = ZoneConfig.RarityIntroZone[rarity] or 1
		local fade = math.clamp((zone - intro + 1) / ZoneConfig.OddsIntroFade, 0, 1)
		if fade > 0 then
			-- weight = commoner→rarer geometric falloff × the slow intro fade (keeps new tiers tiny)
			local w = (shift ^ (i - 1)) * fade
			raw[rarity] = w
			total += w
		end
	end

	-- Normalise to DECIMAL percentages (2 dp), KEEPING every non-zero tier so the teaser odds survive.
	local odds: { [string]: number } = {}
	for rarity, w in pairs(raw) do
		local pct = math.floor(w / total * 10000 + 0.5) / 100 -- e.g. 0.6, 3.93, 80
		if pct > 0 then
			odds[rarity] = pct
		end
	end
	return odds
end

return ZoneConfig
